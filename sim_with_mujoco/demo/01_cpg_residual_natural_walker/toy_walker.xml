<mujoco model="demo_planar_walker">
  <compiler angle="radian" autolimits="true"/>
  <option timestep="0.002" integrator="implicitfast" solver="Newton" iterations="40" ls_iterations="10"/>

  <asset>
    <texture name="grid" type="2d" builtin="checker" width="512" height="512"
             rgb1="0.24 0.26 0.28" rgb2="0.18 0.20 0.22"/>
    <material name="floor_mat" texture="grid" texrepeat="5 1" texuniform="true"/>
    <material name="torso_mat" rgba="0.82 0.18 0.22 1"/>
    <material name="left_leg_mat" rgba="0.12 0.42 0.78 1"/>
    <material name="right_leg_mat" rgba="0.92 0.56 0.13 1"/>
    <material name="foot_mat" rgba="0.08 0.09 0.10 1"/>
  </asset>

  <default>
    <joint armature="0.03" damping="0.4" frictionloss="0.02"/>
    <geom condim="3" density="900" friction="1.3 0.02 0.001"/>
    <default class="leg">
      <joint axis="0 1 0" limited="true"/>
      <geom type="capsule" size="0.045"/>
    </default>
  </default>

  <worldbody>
    <light name="key" pos="-3 -4 5" dir="0.5 0.5 -1"/>
    <geom name="floor" type="plane" pos="0 0 0" size="30 1.6 0.05" material="floor_mat"/>

    <body name="torso" pos="0 0 0">
      <joint name="root_x" type="slide" axis="1 0 0" limited="false" damping="0.05"/>
      <joint name="root_z" type="slide" axis="0 0 1" range="0.45 1.45" damping="0.2"/>
      <joint name="root_pitch" type="hinge" axis="0 1 0" range="-0.65 0.65" damping="0.25"/>
      <geom name="torso_geom" type="capsule" fromto="0 0 -0.12 0 0 0.46"
            size="0.09" mass="7.0" material="torso_mat"/>
      <geom name="head_geom" type="sphere" pos="0 0 0.58" size="0.075" mass="0.8"
            material="torso_mat"/>

      <body name="left_thigh" pos="0 0.055 -0.10">
        <joint name="left_hip" class="leg" range="-1.05 0.95"/>
        <geom name="left_thigh_geom" class="leg" fromto="0 0 0 0 0 -0.36"
              mass="1.8" material="left_leg_mat"/>
        <body name="left_shin" pos="0 0 -0.36">
          <joint name="left_knee" class="leg" range="-0.05 1.55"/>
          <geom name="left_shin_geom" class="leg" fromto="0 0 0 0 0 -0.36"
                mass="1.25" material="left_leg_mat"/>
          <body name="left_foot" pos="0 0 -0.36">
            <joint name="left_ankle" class="leg" range="-0.8 0.8"/>
            <geom name="left_foot_geom" type="box" pos="0.055 0 -0.025"
                  size="0.145 0.045 0.025" mass="0.55" material="foot_mat"/>
          </body>
        </body>
      </body>

      <body name="right_thigh" pos="0 -0.055 -0.10">
        <joint name="right_hip" class="leg" range="-1.05 0.95"/>
        <geom name="right_thigh_geom" class="leg" fromto="0 0 0 0 0 -0.36"
              mass="1.8" material="right_leg_mat"/>
        <body name="right_shin" pos="0 0 -0.36">
          <joint name="right_knee" class="leg" range="-0.05 1.55"/>
          <geom name="right_shin_geom" class="leg" fromto="0 0 0 0 0 -0.36"
                mass="1.25" material="right_leg_mat"/>
          <body name="right_foot" pos="0 0 -0.36">
            <joint name="right_ankle" class="leg" range="-0.8 0.8"/>
            <geom name="right_foot_geom" type="box" pos="0.055 0 -0.025"
                  size="0.145 0.045 0.025" mass="0.55" material="foot_mat"/>
          </body>
        </body>
      </body>
    </body>
  </worldbody>

  <actuator>
    <position name="left_hip_pos" joint="left_hip" kp="75" kv="7"
              ctrlrange="-1.05 0.95" forcerange="-90 90"/>
    <position name="left_knee_pos" joint="left_knee" kp="85" kv="7"
              ctrlrange="-0.05 1.55" forcerange="-90 90"/>
    <position name="left_ankle_pos" joint="left_ankle" kp="55" kv="5"
              ctrlrange="-0.8 0.8" forcerange="-55 55"/>
    <position name="right_hip_pos" joint="right_hip" kp="75" kv="7"
              ctrlrange="-1.05 0.95" forcerange="-90 90"/>
    <position name="right_knee_pos" joint="right_knee" kp="85" kv="7"
              ctrlrange="-0.05 1.55" forcerange="-90 90"/>
    <position name="right_ankle_pos" joint="right_ankle" kp="55" kv="5"
              ctrlrange="-0.8 0.8" forcerange="-55 55"/>
    <position name="torso_pitch_assist" joint="root_pitch" kp="180" kv="18"
              ctrlrange="-0.25 0.25" forcerange="-220 220"/>
    <position name="torso_height_assist" joint="root_z" kp="420" kv="42"
              ctrlrange="0.72 0.98" forcerange="-520 520"/>
  </actuator>

  <keyframe>
    <key name="stand" qpos="0 0.86 0 0.08 0.18 -0.12 0.08 0.18 -0.12"
         ctrl="0.08 0.18 -0.12 0.08 0.18 -0.12 0.08 0.86"/>
  </keyframe>
</mujoco>
